# MAL API app credentials: https://myanimelist.net/apiconfig -> create a new app ("Web" type)
MAL_CLIENT_ID=
MAL_CLIENT_SECRET=
MAL_REDIRECT_URI=http://localhost:8080/callback

# MongoDB (raw staging store)
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=mal_raw

# PostgreSQL (cleaned relational store)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=mal_anime
POSTGRES_USER=mal_user
POSTGRES_PASSWORD=mal_password

# Crawl tuning
MAX_ANIME_ID=60000
REQUEST_DELAY_SECONDS=1.0
USE_JIKAN_ID_DISCOVERY=false
